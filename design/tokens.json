{
  "$description": "Bups Are Alive design tokens, in the W3C Design Tokens (DTCG) format. The one place the interface's colours, type, radii and spacing are defined: tools/gen_theme.py builds the game's theme from it, tools/gen_design.py builds docs/design-system.html.",
  "color": {
    "$type": "color",
    "surfaces": {
      "$description": "Panels share one translucent fill (surface), so the dish shows faintly through. The goal card, dead bup panel, tooltips, dialogs and popups have their own.",
      "surface": {"$value": {"colorSpace": "srgb", "components": [0.082, 0.098, 0.108], "alpha": 0.94}, "$description": "Panels: the tray, top bar, rail, cards"},
      "surface_solid": {"$value": {"colorSpace": "srgb", "components": [0.095, 0.112, 0.122]}, "$description": "Opaque panels: dialogs, popups, the tutorial card"},
      "raised": {"$value": {"colorSpace": "srgb", "components": [0.145, 0.168, 0.18]}, "$description": "Buttons, badges, notices"},
      "sunken": {"$value": {"colorSpace": "srgb", "components": [0.055, 0.066, 0.073]}, "$description": "Inputs, segmented controls, slider and goal-bar tracks"},
      "hover": {"$value": {"colorSpace": "srgb", "components": [0.2, 0.23, 0.245]}, "$description": "Control or row under the pointer"},
      "tooltip_fill": {"$value": {"colorSpace": "srgb", "components": [0.16, 0.18, 0.19], "alpha": 0.98}, "$description": "Tooltips"},
      "deceased_fill": {"$value": {"colorSpace": "srgb", "components": [0.09, 0.09, 0.09], "alpha": 0.94}, "$description": "Dead bup's panel"},
      "goal_fill": {"$value": {"colorSpace": "srgb", "components": [0.11, 0.095, 0.06], "alpha": 0.94}, "$description": "Goal card"},
      "disabled_fill": {"$value": {"colorSpace": "srgb", "components": [0.11, 0.125, 0.135], "alpha": 0.8}, "$description": "Disabled button"},
      "veil": {"$value": {"colorSpace": "srgb", "components": [0.04, 0.05, 0.055], "alpha": 0.92}, "$description": "Screen laid over the game"},
      "scrim": {"$value": {"colorSpace": "srgb", "components": [0.0, 0.01, 0.015], "alpha": 0.6}, "$description": "Dims the game behind a dialog"},
      "scrim_tutorial": {"$value": {"colorSpace": "srgb", "components": [0.0, 0.01, 0.015], "alpha": 0.7}, "$description": "Dims the game around a tutorial step"},
      "none": {"$value": {"colorSpace": "srgb", "components": [0.0, 0.0, 0.0], "alpha": 0.0}, "$description": "No fill or border"}
    },
    "text": {
      "$description": "Off-white, with two dimmer steps.",
      "text": {"$value": {"colorSpace": "srgb", "components": [0.93, 0.95, 0.94]}, "$description": "Primary text and icons", "$extensions": {"app.bups": {"use": "text"}}},
      "muted": {"$value": {"colorSpace": "srgb", "components": [0.63, 0.69, 0.68]}, "$description": "Secondary text: hints, notes, inactive tabs", "$extensions": {"app.bups": {"use": "text"}}},
      "faint": {"$value": {"colorSpace": "srgb", "components": [0.42, 0.47, 0.46]}, "$description": "Units, disabled text, a dead bup's bar", "$extensions": {"app.bups": {"use": "graphic"}}},
      "deceased_text": {"$value": {"colorSpace": "srgb", "components": [0.55, 0.58, 0.57]}, "$description": "Dead bup in a list", "$extensions": {"app.bups": {"use": "text"}}},
      "deceased_text_hi": {"$value": {"colorSpace": "srgb", "components": [0.75, 0.78, 0.77]}, "$description": "Dead bup in a list, hovered", "$extensions": {"app.bups": {"use": "text"}}},
      "outline": {"$value": {"colorSpace": "srgb", "components": [0.0, 0.0, 0.0], "alpha": 0.85}, "$description": "Outline of text over the dish (banners)"},
      "on_band": {"$value": {"colorSpace": "srgb", "components": [0.05, 0.07, 0.08], "alpha": 0.92}, "$description": "Gene symbol on its genome-map band"}
    },
    "accent": {
      "$description": "Teal-green.",
      "accent": {"$value": {"colorSpace": "srgb", "components": [0.38, 0.86, 0.64]}, "$description": "Selection, main action, focus on fields and sliders", "$extensions": {"app.bups": {"use": "text"}}},
      "accent_hi": {"$value": {"colorSpace": "srgb", "components": [0.52, 0.93, 0.74]}, "$description": "Accent on hover; a number's flash", "$extensions": {"app.bups": {"use": "text"}}},
      "accent_pressed": {"$value": {"colorSpace": "srgb", "components": [0.3, 0.72, 0.52]}, "$description": "Pressed primary button"},
      "accent_dim": {"$value": {"colorSpace": "srgb", "components": [0.38, 0.86, 0.64], "alpha": 0.16}, "$description": "Faint accent fill: pressed rows, done steps"},
      "on_accent": {"$value": {"colorSpace": "srgb", "components": [0.04, 0.13, 0.09]}, "$description": "Text and icons on an accent fill"}
    },
    "status": {
      "$description": "Amber, coral and red.",
      "emphasis": {"$value": {"colorSpace": "srgb", "components": [1.0, 0.76, 0.32]}, "$description": "Goals, names and card titles; a reserve at its floor", "$extensions": {"app.bups": {"use": "text"}}},
      "warning": {"$value": {"colorSpace": "srgb", "components": [0.98, 0.56, 0.42]}, "$description": "Warning icon", "$extensions": {"app.bups": {"use": "graphic"}}},
      "warning_text": {"$value": {"colorSpace": "srgb", "components": [1.0, 0.78, 0.7]}, "$description": "Warning text, beside the icon", "$extensions": {"app.bups": {"use": "text"}}},
      "danger": {"$value": {"colorSpace": "srgb", "components": [0.96, 0.4, 0.36]}, "$description": "Danger: starving, destructive actions", "$extensions": {"app.bups": {"use": "text"}}},
      "danger_pressed": {"$value": {"colorSpace": "srgb", "components": [0.82, 0.32, 0.3]}, "$description": "Destructive button while pressed"},
      "danger_text": {"$value": {"colorSpace": "srgb", "components": [1.0, 0.62, 0.58]}, "$description": "Text of an outlined destructive button", "$extensions": {"app.bups": {"use": "text"}}},
      "on_danger": {"$value": {"colorSpace": "srgb", "components": [0.2, 0.04, 0.04]}, "$description": "Text on a solid danger fill"}
    },
    "white": {
      "$description": "Pure white, drawn at set opacities for borders, hovers, tracks and scrollbars.",
      "white": {"$value": {"colorSpace": "srgb", "components": [1.0, 1.0, 1.0]}, "$description": "Picture icons; borders, hovers, tracks and scrollbars at set opacities"}
    }
  },
  "opacity": {
    "$type": "number",
    "$description": "How opaque white is drawn for each use; not on the design page.",
    "hair": {"$value": 0.09, "$description": "Hairline border of a panel"},
    "popup_border": {"$value": 0.14, "$description": "Border of popups, dialogs and tooltips"},
    "field_border": {"$value": 0.12, "$description": "Field border"},
    "notice_border": {"$value": 0.16, "$description": "Notice border"},
    "slider_border": {"$value": 0.1, "$description": "Slider track border"},
    "select_border_hover": {"$value": 0.25, "$description": "Hovered select border"},
    "pill_border": {"$value": 0.18, "$description": "Graph pill border"},
    "pill_border_hover": {"$value": 0.32, "$description": "Border of a hovered graph pill"},
    "deceased_border": {"$value": 0.07, "$description": "Border of a dead bup's panel"},
    "separator": {"$value": 0.12, "$description": "Separators"},
    "stat_leader": {"$value": 0.16, "$description": "Dotted line between a stat and its value"},
    "section_hover": {"$value": 0.05, "$description": "Hover on a section heading"},
    "menu_hover": {"$value": 0.09, "$description": "Hover on a menu item"},
    "choice_hover": {"$value": 0.07, "$description": "Hover on a tab or choice"},
    "pill_hover": {"$value": 0.08, "$description": "Hover on a graph pill"},
    "scroll_track": {"$value": 0.05, "$description": "Scrollbar track"},
    "track": {"$value": 0.07, "$description": "Gauge and genome-slot tracks"},
    "scroll_grabber": {"$value": 0.32, "$description": "Scrollbar grabber"},
    "scroll_grabber_hover": {"$value": 0.6, "$description": "Scrollbar grabber, hovered"},
    "gauge_floor": {"$value": 0.13, "$description": "Reserve gauge floor band"},
    "gauge_tick": {"$value": 0.9, "$description": "Gauge tick marks"},
    "grid": {"$value": 0.07, "$description": "Graph grid"},
    "grid_faint": {"$value": 0.04, "$description": "Faint graph grid"},
    "gene_symbol_dim": {"$value": 0.4, "$description": "Dim gene symbol"},
    "icon_disabled": {"$value": 0.22, "$description": "Disabled icon"}
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "text": {"$value": ["IBM Plex Sans"], "$description": "All text", "$extensions": {"app.bups": {"body_height": 0.952}}},
      "mono": {"$value": ["Commit Mono"], "$description": "Every number: stat values, units, the graph, readouts, figures inside text", "$extensions": {"app.bups": {"body_height": 0.951}}}
    },
    "weight": {
      "$type": "fontWeight",
      "light": {"$value": 300, "$description": "Long text and big type: descriptions, titles", "$extensions": {"app.bups": {"family": "text", "file": "fonts/IBMPlexSans-300.ttf"}}},
      "regular": {"$value": 400, "$description": "Buttons, labels, everything you act on", "$extensions": {"app.bups": {"family": "text", "file": "fonts/IBMPlexSans-400.ttf"}}},
      "medium": {"$value": 500, "$description": "Only the warning", "$extensions": {"app.bups": {"family": "text", "file": "fonts/IBMPlexSans-500.ttf"}}},
      "bold": {"$value": 700, "$description": "Only the game title on the title screen", "$extensions": {"app.bups": {"family": "text", "file": "fonts/IBMPlexSans-700.ttf"}}},
      "mono_medium": {"$value": 500, "$description": "Numbers", "$extensions": {"app.bups": {"family": "mono", "file": "fonts/CommitMono-500.otf", "uid": "uid://dvk0wfx7w138g"}}},
      "mono_bold": {"$value": 700, "$description": "Emphasised numbers in a readout", "$extensions": {"app.bups": {"family": "mono", "file": "fonts/CommitMono-700.otf", "uid": "uid://dorcirpa3je5u"}}}
    },
    "size": {
      "$type": "dimension",
      "xs": {"$value": {"value": 12, "unit": "px"}, "$description": "Genome map symbols, graph ticks"},
      "s": {"$value": {"value": 13, "unit": "px"}, "$description": "Hints, notes, units, badges, popup menus, section headings"},
      "m": {"$value": {"value": 14, "unit": "px"}, "$description": "Small buttons, fields, notices, readouts"},
      "base": {"$value": {"value": 15, "unit": "px"}, "$description": "Body text and buttons"},
      "l": {"$value": {"value": 16, "unit": "px"}, "$description": "Names, dialog text, readout fields"},
      "xl": {"$value": {"value": 18, "unit": "px"}, "$description": "Story text"},
      "2xl": {"$value": {"value": 20, "unit": "px"}, "$description": "Card and dialog titles, taglines"},
      "3xl": {"$value": {"value": 22, "unit": "px"}, "$description": "Headings"},
      "4xl": {"$value": {"value": 26, "unit": "px"}, "$description": "Banners"},
      "5xl": {"$value": {"value": 40, "unit": "px"}, "$description": "Screen titles"},
      "6xl": {"$value": {"value": 66, "unit": "px"}, "$description": "Game title"}
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {"$value": {"value": 6, "unit": "px"}, "$description": "Buttons, fields, tooltips"},
    "panel": {"$value": {"value": 10, "unit": "px"}, "$description": "Panels and cards"}
  },
  "border": {
    "$type": "dimension",
    "hairline": {"$value": {"value": 1, "unit": "px"}, "$description": "Panels, cards, fields, selected buttons"},
    "focus": {"$value": {"value": 2, "unit": "px"}, "$description": "Focus ring"},
    "ring": {"$value": {"value": 3, "unit": "px"}, "$description": "Tutorial spotlight, selection ring"}
  },
  "icon": {
    "$type": "dimension",
    "s": {"$value": {"value": 16, "unit": "px"}, "$description": "Small buttons, section headings", "$extensions": {"app.bups": {"theme": "SmallButton, SectionButton"}}},
    "m": {"$value": {"value": 18, "unit": "px"}, "$description": "Icon buttons", "$extensions": {"app.bups": {"theme": "IconButton"}}},
    "l": {"$value": {"value": 20, "unit": "px"}, "$description": "Tools and toggles", "$extensions": {"app.bups": {"theme": "ToolButton, ToolButtonArmed, ToggleButton"}}},
    "xl": {"$value": {"value": 22, "unit": "px"}, "$description": "Choice buttons", "$extensions": {"app.bups": {"theme": "ChoiceButton"}}},
    "2xl": {"$value": {"value": 24, "unit": "px"}, "$description": "Picture buttons, the warning icon", "$extensions": {"app.bups": {"theme": "PictureButton, WarningIcon"}}}
  },
  "spacing": {
    "$type": "dimension",
    "snug": {"$value": {"value": 4, "unit": "px"}, "$description": "Things that belong together", "$extensions": {"app.bups": {"theme": "SnugStack"}}},
    "tight": {"$value": {"value": 8, "unit": "px"}, "$description": "Related rows", "$extensions": {"app.bups": {"theme": "TightStack"}}},
    "roomy": {"$value": {"value": 16, "unit": "px"}, "$description": "Groups within a section", "$extensions": {"app.bups": {"theme": "RoomyStack"}}},
    "spacious": {"$value": {"value": 24, "unit": "px"}, "$description": "Unrelated groups", "$extensions": {"app.bups": {"theme": "SpaciousStack"}}},
    "section": {"$value": {"value": 28, "unit": "px"}, "$description": "Sections of a screen", "$extensions": {"app.bups": {"theme": "SectionStack"}}}
  }
}
