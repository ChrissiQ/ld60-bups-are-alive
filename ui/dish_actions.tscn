[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/dish_actions.gd" id="1"]

[node name="DishActions" type="HFlowContainer"]
theme_type_variation = &"TightFlow"
script = ExtResource("1")

[node name="Freeze" type="Button" parent="."]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "@hud.freeze_this"
tooltip_text = "@hud.freeze_tip"

[node name="Trash" type="Button" parent="."]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "@hud.trash_this"
tooltip_text = "@hud.trash_tip"
