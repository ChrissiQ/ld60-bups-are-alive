[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://ui/dish_actions.gd" id="1"]
[ext_resource type="Texture2D" path="res://icons/warning.svg" id="2"]

[node name="DishActions" type="VBoxContainer"]
theme_type_variation = &"TightStack"
script = ExtResource("1")

[node name="Buttons" type="HFlowContainer" parent="."]
layout_mode = 2
theme_type_variation = &"TightFlow"

[node name="Freeze" type="Button" parent="Buttons"]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "@hud.freeze_this"
tooltip_text = "@hud.freeze_tip"

[node name="Trash" type="Button" parent="Buttons"]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "@hud.trash_this"
tooltip_text = "@hud.trash_tip"

[node name="Limit" type="HBoxContainer" parent="."]
visible = false
layout_mode = 2

[node name="WarningIcon" type="Button" parent="Limit"]
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"WarningIcon"
disabled = true
focus_mode = 0
mouse_filter = 2
icon = ExtResource("2")
icon_alignment = 1
expand_icon = true

[node name="Note" type="Label" parent="Limit"]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Warning"
text = "@banner.dish_limit"
vertical_alignment = 1
autowrap_mode = 3
