[gd_scene format=3]

[ext_resource type="Script" path="res://ui/memory_row.gd" id="1"]
[ext_resource type="PackedScene" path="res://ui/setting_row.tscn" id="setting_row"]

[node name="MemoryRow" type="VBoxContainer"]
theme_type_variation = &"TightStack"
script = ExtResource("1")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Name" type="Label" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
text = "@options.memory"

[node name="Segments" type="PanelContainer" parent="Row"]
layout_mode = 2
theme_type_variation = &"SwitchSegments"

[node name="Choices" type="HBoxContainer" parent="Row/Segments"]
layout_mode = 2
theme_type_variation = &"SegmentRow"

[node name="AutoButton" type="Button" parent="Row/Segments/Choices"]
layout_mode = 2
theme_type_variation = &"SwitchButton"
toggle_mode = true
text = "@options.memory_auto"

[node name="LowButton" type="Button" parent="Row/Segments/Choices"]
layout_mode = 2
theme_type_variation = &"SwitchButton"
toggle_mode = true
text = "@options.memory_low"

[node name="CustomButton" type="Button" parent="Row/Segments/Choices"]
layout_mode = 2
theme_type_variation = &"SwitchButton"
toggle_mode = true
text = "@options.memory_custom"

[node name="AmountRow" parent="." instance=ExtResource("setting_row")]
visible = false
layout_mode = 2
label_text = "@options.memory_limit"
slider_min_width = 160.0

[node name="Hint" type="Label" parent="."]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"Note"
autowrap_mode = 3
