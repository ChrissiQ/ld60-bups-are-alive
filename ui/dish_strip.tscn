[gd_scene format=3]

[ext_resource type="Script" path="res://ui/dish_strip.gd" id="1"]
[ext_resource type="Texture2D" path="res://icons/chevron_left.svg" id="2"]
[ext_resource type="Texture2D" path="res://icons/chevron_right.svg" id="3"]

[node name="DishStrip" type="PanelContainer"]
visible = false
theme_type_variation = &"Segments"
size_flags_vertical = 4
script = ExtResource("1")

[node name="Bar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_type_variation = &"SegmentRow"

[node name="Previous" type="Button" parent="Bar"]
visible = false
layout_mode = 2
theme_type_variation = &"IconButton"
focus_mode = 0
tooltip_text = "@dishes.scroll_left"
icon = ExtResource("2")
icon_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Bar"]
layout_mode = 2
horizontal_scroll_mode = 3
vertical_scroll_mode = 0

[node name="Row" type="HBoxContainer" parent="Bar/Scroll"]
layout_mode = 2
theme_type_variation = &"SegmentRow"

[node name="Next" type="Button" parent="Bar"]
visible = false
layout_mode = 2
theme_type_variation = &"IconButton"
focus_mode = 0
tooltip_text = "@dishes.scroll_right"
icon = ExtResource("3")
icon_alignment = 1
