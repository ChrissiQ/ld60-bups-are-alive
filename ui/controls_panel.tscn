[gd_scene format=3]

[ext_resource type="Script" path="res://ui/controls_panel.gd" id="1"]

[node name="ControlsPanel" type="PanelContainer"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 40.0
offset_top = 24.0
offset_right = -40.0
offset_bottom = -24.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_type_variation = &"RoomyStack"

[node name="Heading" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"Heading"
text = "@menu.controls_title"
horizontal_alignment = 1

[node name="Intro" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"Note"
text = "@keys.intro"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Box"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Keys" type="GridContainer" parent="Box/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
columns = 4

[node name="Message" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"Accent"
horizontal_alignment = 1

[node name="Actions" type="HBoxContainer" parent="Box"]
layout_mode = 2

[node name="ResetButton" type="Button" parent="Box/Actions"]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "@keys.reset"

[node name="BackButton" type="Button" parent="Box/Actions"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 3
text = "@menu.back"
