[gd_scene format=3]

[ext_resource type="Script" path="res://ui/toggle_row.gd" id="1"]

[node name="ToggleRow" type="VBoxContainer"]
theme_type_variation = &"TightStack"
script = ExtResource("1")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Name" type="Label" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3

[node name="AutoCheck" type="CheckBox" parent="Row"]
visible = false
layout_mode = 2

[node name="Segments" type="PanelContainer" parent="Row"]
layout_mode = 2
theme_type_variation = &"SwitchSegments"

[node name="Choices" type="HBoxContainer" parent="Row/Segments"]
layout_mode = 2
theme_type_variation = &"SegmentRow"

[node name="OnButton" type="Button" parent="Row/Segments/Choices"]
layout_mode = 2
theme_type_variation = &"SwitchButton"
toggle_mode = true
text = "@ui.toggle_on"

[node name="OffButton" type="Button" parent="Row/Segments/Choices"]
layout_mode = 2
theme_type_variation = &"SwitchButton"
toggle_mode = true
text = "@ui.toggle_off"

[node name="Hint" type="Label" parent="."]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"Note"
autowrap_mode = 3
