[gd_scene format=3]

[ext_resource type="Script" path="res://ui/layers_panel.gd" id="1"]
[ext_resource type="Texture2D" path="res://icons/layer_medium.svg" id="medium_icon"]
[ext_resource type="Texture2D" path="res://icons/pick_source.svg" id="sources_icon"]
[ext_resource type="Texture2D" path="res://icons/pick_plankton.svg" id="plankton_icon"]
[ext_resource type="Texture2D" path="res://icons/pick_bup.svg" id="bups_icon"]
[ext_resource type="Texture2D" path="res://icons/layer_steering.svg" id="steering_icon"]

[node name="LayersPanel" type="PanelContainer"]
theme_type_variation = &"ToolbarPanel"
offset_left = 20.0
offset_top = 16.0
script = ExtResource("1")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2
theme_type_variation = &"TightRow"

[node name="MediumButton" type="Button" parent="Row"]
layout_mode = 2
theme_type_variation = &"ToolButton"
icon = ExtResource("medium_icon")
icon_alignment = 1

[node name="SourcesButton" type="Button" parent="Row"]
layout_mode = 2
theme_type_variation = &"ToolButton"
icon = ExtResource("sources_icon")
icon_alignment = 1

[node name="PlanktonButton" type="Button" parent="Row"]
layout_mode = 2
theme_type_variation = &"ToolButton"
icon = ExtResource("plankton_icon")
icon_alignment = 1

[node name="BupsButton" type="Button" parent="Row"]
layout_mode = 2
theme_type_variation = &"ToolButton"
icon = ExtResource("bups_icon")
icon_alignment = 1

[node name="SteeringButton" type="Button" parent="Row"]
layout_mode = 2
theme_type_variation = &"ToolButton"
icon = ExtResource("steering_icon")
icon_alignment = 1
