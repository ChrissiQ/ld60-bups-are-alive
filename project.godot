; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bups Are Alive"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TextSweep="*res://scripts/text_sweep.gd"
DialogStyle="*res://scripts/dialog_style.gd"
DebugHotkey="*res://ui/debug_hotkey.tscn"
PreferencesHook="*res://scripts/preferences_hook.gd"
TooltipFit="*res://scripts/tooltip_fit.gd"
ScrollKeep="*res://scripts/scroll_keep.gd"

[display]

window/size/mode=2

[gui]

theme/custom="res://scenes/menu_theme.tres"
theme/custom_font="res://fonts/IBMPlexSans-400.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.025, 1)
