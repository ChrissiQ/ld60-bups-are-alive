	if (d != NO_DISH && l < DS(d, DS_COUNT)) {
		ac_apply(i, d, l);
		conj_apply(i, d, l);
		if (CBKT[i] != NOT_DONOR) return;
	}
	life_slot(i, d, l);
}
SLOT_LOOP(ac_conj_life)
