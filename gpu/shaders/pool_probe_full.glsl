	across = TABLE[o2 + k00] * w00 + TABLE[o2 + k10] * w10 + TABLE[o2 + k01] * w01 + TABLE[o2 + k11] * w11;
	if (below < 1.0) {
		float flatd = TABLE[o3 + j] * (1.0 - ty) + TABLE[o3 + j + 1] * ty;
		along = flatd + (along - flatd) * below;
		across = flatd + (across - flatd) * below;
