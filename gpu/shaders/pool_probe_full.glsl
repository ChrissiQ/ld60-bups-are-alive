	float y = clamp((log(max(eps, 1e-12)) - P[P_MOTION_LE0]) / P[P_MOTION_DLE], 0.0, float(ne - 1) - 1e-4);
	int i = int(x), j = int(y);
	float tx = x - float(i), ty = y - float(j);
