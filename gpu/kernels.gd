	puffs_at(PQ[i * 2u], PQ[i * 2u + 1u], c, gx, gy, sg);
	PR[i * 4u] = c; PR[i * 4u + 1u] = gx; PR[i * 4u + 2u] = gy; PR[i * 4u + 3u] = sg;
