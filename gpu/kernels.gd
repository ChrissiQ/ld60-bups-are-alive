		OUT[o + 8u] = floatBitsToUint(sm[7 * 256]);  // (the mutator's sum)
		OUT[o + 9u] = CNT[15];  // (the donors of the last step)
		for (uint k = 10u; k < 16u; k++) OUT[o + k] = 0u;
	}
}
"""

## The frame's answers start empty, and CNT and PCNT are copied (one thread per word of QOUT, and of the head).
const K_Q_CLEAR := """
void main() {
	uint t = gl_GlobalInvocationID.x;
	if (t < 16u) OUT[t] = CNT[t];
	else if (t < 24u) OUT[t] = PCNT[t - 16u];
	if (t >= 240u) return;
	uint q = OUT_Q + t;
	uint v = 0u;
	if (t == 0u || t == 1u || t == 26u) v = 0xFFFFFFFFu;  // (no pick; d² past any, for atomicMin)
	if (t >= 36u && t < 228u) { uint w = (t - 36u) % 24u; if (w == 0u || w == 21u) v = 0xFFFFFFFFu; }  // (a tracked bup not found)
	if (t >= 228u && t < 234u && (t - 228u) % 2u == 0u) v = 0xFFFFFFFFu;
	OUT[q] = v;
}
"""

## The pick (BupSim.pick_bup's rule: within half its drawn length plus the slack, the nearest; ties to the smaller index): the least d²
## by atomicMin on its bits (they order as the floats do, for d² >= 0), each bup's own kept in QD for the second pass.
const K_Q_PICK := """
void main() {
	uint i = gl_GlobalInvocationID.x; if (i >= CNT[0] || QIN[0] == 0u) return;
	uint b = i * 24u;
	float px = uintBitsToFloat(QIN[1]), py = uintBitsToFloat(QIN[2]), slack = uintBitsToFloat(QIN[3]), pixel = uintBitsToFloat(QIN[4]);
	float reach = 0.5 * max(BUPS[b + 6u] * P[14], P[74] * pixel) + slack;
	float dx = BUPS[b + 1u] - px, dy = BUPS[b + 2u] - py;
	float d2 = dx * dx + dy * dy;
	uint bits = 0xFFFFFFFFu;
	if (d2 <= reach * reach) { bits = floatBitsToUint(d2); atomicMin(OUT[OUT_Q + 1u], bits); }
	QD[i] = bits;
}
"""

const K_Q_PICK2 := """
void main() {
	uint i = gl_GlobalInvocationID.x; if (i >= CNT[0] || QIN[0] == 0u) return;
	if (QD[i] != 0xFFFFFFFFu && QD[i] == OUT[OUT_Q + 1u]) atomicMin(OUT[OUT_Q], i);
}
"""

## The picked bup's record (24 threads), and every tracked bup's (one thread per bup: the one with that id copies its record).
const K_Q_RECORD := """
void main() {
	uint t = gl_GlobalInvocationID.x; if (t >= 24u) return;
	uint k = OUT[OUT_Q];
	if (k != 0xFFFFFFFFu) OUT[OUT_Q + 2u + t] = BUPS_U[k * 24u + t];
}
"""

const K_Q_TRACK := """
void main() {
	uint i = gl_GlobalInvocationID.x; if (i >= CNT[0]) return;
	uint n = QIN[27]; if (n == 0u) return;
	uint b = i * 24u, lo = BUPS_U[b], hi = BUPS_U[b + 21u];
	for (uint t = 0u; t < n; t++) {
		if (QIN[28u + 2u * t] == lo && QIN[29u + 2u * t] == hi) {
			uint o = OUT_Q + 36u + t * 24u;
			for (uint w = 0u; w < 24u; w++) OUT[o + w] = BUPS_U[b + w];
		}
	}
}
"""

## The nearest bup and the count within `near` for each nearest slot, and the count at or above each fraction's threshold: summed (and the
## least found) in each group of 256 first, then one atomic per group.
const K_Q_SCAN := """
shared uint smin[4 * 256];
shared uint scnt[8 * 256];
void main() {
	uint i = gl_GlobalInvocationID.x, l = gl_LocalInvocationID.x;
	uint nn = QIN[5], nf = QIN[18];
	bool live = i < CNT[0];
	uint b = i * 24u;
	float x = live ? BUPS[b + 1u] : 0.0, y = live ? BUPS[b + 2u] : 0.0;
	for (uint s = 0u; s < 4u; s++) {
		uint m = 0xFFFFFFFFu, c = 0u;
		if (live && s < nn) {
			float qx = uintBitsToFloat(QIN[6u + 3u * s]), qy = uintBitsToFloat(QIN[7u + 3u * s]), near = uintBitsToFloat(QIN[8u + 3u * s]);
			float dx = x - qx, dy = y - qy, d2 = dx * dx + dy * dy;
			m = floatBitsToUint(d2);
			c = d2 <= near * near ? 1u : 0u;
		}
		smin[s * 256u + l] = m; scnt[s * 256u + l] = c;
	}
	for (uint f = 0u; f < 4u; f++) {
		uint c = 0u;
		if (live && f < nf) c = BUPS[b + 8u + QIN[19u + 2u * f]] >= uintBitsToFloat(QIN[20u + 2u * f]) ? 1u : 0u;
		scnt[(4u + f) * 256u + l] = c;
	}
	barrier();
	for (uint half_ = 128u; half_ > 0u; half_ >>= 1u) {
		if (l < half_) {
			for (uint s = 0u; s < 4u; s++) smin[s * 256u + l] = min(smin[s * 256u + l], smin[s * 256u + l + half_]);
			for (uint k = 0u; k < 8u; k++) scnt[k * 256u + l] += scnt[k * 256u + l + half_];
		}
		barrier();
	}
	if (l == 0u) {
		for (uint s = 0u; s < nn; s++) {
			uint od = s == 0u ? OUT_Q + 26u : OUT_Q + 228u + 2u * (s - 1u);
			if (smin[s * 256u] != 0xFFFFFFFFu) atomicMin(OUT[od], smin[s * 256u]);
			if (scnt[s * 256u] > 0u) atomicAdd(OUT[od + 1u], scnt[s * 256u]);
		}
		for (uint f = 0u; f < nf; f++) if (scnt[(4u + f) * 256u] > 0u) atomicAdd(OUT[OUT_Q + 28u + f], scnt[(4u + f) * 256u]);
	}
}
"""

## The eraser (NutrientField::erase_disc): each disc of ERASE (x, y, radius, strength; `pcs.pa` of them, in order) takes from the cells
## inside the dish whose centres lie within it, and from the clouds whose centres do, the share strength * (1 - d / radius).
const K_ERASE_CELLS := """
void main() {
	uint i = gl_GlobalInvocationID.x; int n = int(P[1]);
	if (i >= uint(n * n) || INSIDE[i] == 0) return;
	float cx = (float(int(i) % n) + 0.5) * P[2] - P[3], cy = (float(int(i) / n) + 0.5) * P[2] - P[3];
	float c = CONC[i];
	for (int e = 0; e < int(pcs.pa); e++) {
		vec4 d = ERASE[e];
		float dist = sqrt((cx - d.x) * (cx - d.x) + (cy - d.y) * (cy - d.y));
		if (dist < d.z) c -= c * d.w * (1.0 - dist / d.z);
	}
	CONC[i] = c;
}
"""

const K_ERASE_PUFFS := """
void main() {
	uint k = gl_GlobalInvocationID.x; if (k >= PCNT[0]) return;
	uint o = k * 8u;
	if (PUFF[o + 5u] < 0.5) return;
	float m = PUFF[o + 2u];
	for (int e = 0; e < int(pcs.pa); e++) {
		vec4 d = ERASE[e];
		float dist = sqrt((PUFF[o] - d.x) * (PUFF[o] - d.x) + (PUFF[o + 1u] - d.y) * (PUFF[o + 1u] - d.y));
		if (dist < d.z) m -= m * d.w * (1.0 - dist / d.z);
	}
	PUFF[o + 2u] = m;
}
"""

## A copy of OUT's first `pcs.pa` words to OUTK from word `pcs.pb` (the batch's event set's copy).
const K_OUT_KEEP := """
void main() { uint t = gl_GlobalInvocationID.x; if (t >= uint(pcs.pa)) return; OUTK[uint(pcs.pb) + t] = OUT[t]; }
"""

## The field's copy for the CPU (NutrientField.import_packed): MIRROR[0] the slots in use, then 5 floats per slot for the first `pcs.pa`
## slots (x, y, mass, variance, cut; all 0 for a slot that holds no cloud, which import_packed passes over).
const K_MIRROR := """
void main() {
	uint k = gl_GlobalInvocationID.x; if (k >= uint(pcs.pa)) return;
	if (k == 0u) MIRROR[0] = float(PCNT[0]);
	uint o = 1u + k * 5u, q = k * 8u;
	bool live = k < PCNT[0] && PUFF[q + 5u] > 0.5;
	MIRROR[o] = live ? PUFF[q] : 0.0; MIRROR[o + 1u] = live ? PUFF[q + 1u] : 0.0; MIRROR[o + 2u] = live ? PUFF[q + 2u] : 0.0;
	MIRROR[o + 3u] = live ? PUFF[q + 3u] : 0.0; MIRROR[o + 4u] = live ? PUFF[q + 4u] : 0.0;
}
"""

## Every kernel: name -> {"source": the text of its .glsl file (the comment line, `#[compute]`, then the GLSL), "buffers": the names
## bound in order, "local_size": threads per group}. The simulation's kernels (`core()`) and the drawing's (GpuKernelsDraw.all()).
static func all() -> Dictionary:
	var out := core()
	var draw := GpuKernelsDraw.all()
	for kernel_name: String in draw:
		assert(not out.has(kernel_name), "kernel %s is defined twice (gpu/kernels.gd and gpu/kernels_draw.gd)" % kernel_name)
		out[kernel_name] = draw[kernel_name]
	return out


## The simulation's kernels.
static func core() -> Dictionary:
	assert(OUT_Q == 32 and OUT_STATS == 272, "LAYOUT_GLSL must match OUT_Q and OUT_STATS")
	var out := {}
	_add(out, "feed", K_FEED, ["P", "CONC", "WGT"])
	_add(out, "clear", K_CLEAR, ["P", "DLO", "DHI", "RLO", "RHI", "ALO", "AHI"])
	_add(out, "snapshot", K_SNAPSHOT, ["P", "CONC", "OWNER", "EFF"])
	_add(out, "swim", K_SWIM, ["P", "CNT", "BUPS", "EFF", "TABLE", "ENTD", "BINS", "BINC"], FIELD_FUNCS + LOOKUP_FUNCS + CLOUD_FUNCS)
	_add(out, "demand", K_DEMAND, ["P", "CNT", "BUPS", "EFF", "OWNER", "CONC", "WANT", "WANTC", "CELLOF", "DLO", "DHI", "RLO", "RHI", "ALO", "AHI", "ENTD", "BINS", "BINC", "PDLO", "PDHI"], CLOUD_FUNCS)
	_add(out, "cells", K_CELLS, ["P", "CONC", "OWNER", "DLO", "DHI", "RLO", "RHI", "ALO", "AHI", "SCALE"])
	_add(out, "apply", K_APPLY, ["P", "CNT", "BUPS", "WANT", "WANTC", "CELLOF", "SCALE", "ENTD", "BINS", "BINC", "PSCALE"], CLOUD_FUNCS)
	_add(out, "diffuse_a", K_DIFFUSE.replace("SRC", "CONC").replace("DST", "EFF"), ["P", "INSIDE", "CONC", "EFF"])
	_add(out, "diffuse_b", K_DIFFUSE.replace("SRC", "EFF").replace("DST", "CONC"), ["P", "INSIDE", "EFF", "CONC"])
	_add(out, "life", K_LIFE, ["P", "CNT", "BUPS", "CHILD", "SURV", "KID"])
	_add(out, "scan0_s", K_SCAN.replace("SRC", "SURV").replace("DST", "EXCS").replace("SUMS", "S1"), ["SURV", "EXCS", "S1"], "", 256)
	_add(out, "scan0_k", K_SCAN.replace("SRC", "KID").replace("DST", "EXCK").replace("SUMS", "S1"), ["KID", "EXCK", "S1"], "", 256)
	_add(out, "scan1", K_SCAN.replace("SRC", "S1").replace("DST", "S1X").replace("SUMS", "S2"), ["S1", "S1X", "S2"], "", 256)
	_add(out, "scan2", K_SCAN.replace("SRC", "S2").replace("DST", "S2X").replace("SUMS", "S3"), ["S2", "S2X", "S3"], "", 256)
	_add(out, "add2", K_ADD.replace("DST", "S1X").replace("ADDEND", "S2X"), ["S1X", "S2X"], "", 256)
	_add(out, "add1_s", K_ADD.replace("DST", "EXCS").replace("ADDEND", "S1X"), ["EXCS", "S1X"], "", 256)
	_add(out, "add1_k", K_ADD.replace("DST", "EXCK").replace("ADDEND", "S1X"), ["EXCK", "S1X"], "", 256)
	_add(out, "finalize", K_FINALIZE, ["P", "CNT", "SURV", "KID", "EXCS", "EXCK"])
	_add(out, "compact", K_COMPACT, ["P", "CNT", "BUPS_V4U", "BUPS2_V4U", "CHILD_V4U", "SURV", "KID", "EXCS", "EXCK"])
	_add(out, "copy", K_COPY, ["CNT", "BUPS_V4U", "BUPS2_V4U"])
	_add(out, "setcount", K_SETCOUNT, ["CNT"])
	_add(out, "ev_puffs", K_EV_PUFFS, ["P", "PCNT", "PUFF", "EVR", "EVP", "CONC", "INSIDE"])
	_add(out, "ev_deposits", K_EV_DEPOSITS, ["P", "CONC", "EVR", "EVCC", "EVCA"])
	_add(out, "puff_advance", K_PUFF_ADVANCE, ["P", "PCNT", "PUFF", "INSIDE", "DPLO", "DPHI"], DEP_FUNCS)
	_add(out, "dep_apply", K_DEP_APPLY, ["P", "CONC", "DPLO", "DPHI"])
	_add(out, "puff_clear", K_PUFF_CLEAR, ["P", "PDLO", "PDHI", "PSCALE"])
	_add(out, "puff_scale", K_PUFF_SCALE, ["PCNT", "PUFF", "PDLO", "PDHI", "PSCALE"])
	_add(out, "puff_commit", K_PUFF_COMMIT, ["PCNT", "PUFF", "PDLO", "PDHI", "PSCALE"])
	_add(out, "bin_clear", K_BIN_CLEAR, ["P", "BINC"])
	_add(out, "bin_count", K_BIN_COUNT, ["P", "PCNT", "PUFF", "BINC"])
	_add(out, "bin_cursor", K_BIN_CURSOR, ["P", "BINS", "BCUR"])
	_add(out, "bin_scatter", K_BIN_SCATTER, ["P", "PCNT", "PUFF", "BCUR", "ENT"])
	_add(out, "bin_sort", K_BIN_SORT, ["P", "PUFF", "BINS", "BINC", "ENT", "ENTD"])
	_add_scan_chain(out, "bn", "BINC", "BINS", "BS1", "BS1X", "BS2", "BS2X", "BS3")
	_add(out, "pmark", K_PMARK, ["P", "PCNT", "PUFF", "PAL"])
	_add_scan_chain(out, "pf", "PAL", "PEXC", "PS1", "PS1X", "PS2", "PS2X", "PS3")
	_add(out, "pcompact", K_PCOMPACT, ["PCNT", "PAL", "PEXC", "PUFF_V", "PUFF2_V"])
	_add(out, "pfinal", K_PFINAL, ["PCNT", "PAL", "PEXC"])
	_add(out, "pcopy", K_PCOPY, ["PCNT", "PUFF_V", "PUFF2_V"])
	_add(out, "psetcount", K_PSETCOUNT, ["PCNT"])
	_add(out, "probe", K_PROBE, ["P", "ENTD", "BINS", "BINC", "PQ", "PR"], CLOUD_FUNCS)
	# the game's side
	_add(out, "ev_begin", K_EV_BEGIN, ["CNT"])
	_add(out, "conj_clear", K_CONJ_CLEAR, ["CNT", "DTAB"], CONJ_FUNCS)
	_add(out, "conj_insert", K_CONJ_INSERT, ["P", "CNT", "BUPS", "DTAB"], CONJ_FUNCS)
	_add(out, "conj_apply", K_CONJ_APPLY, ["P", "CNT", "BUPS", "DTAB"], CONJ_FUNCS)
	_add(out, "death_clouds", K_DEATH_CLOUDS, ["P", "CNT", "PCNT", "BUPS", "SURV", "EXCS", "PUFF", "INSIDE", "DPLO", "DPHI"], DEP_FUNCS)
	_add(out, "death_count", K_DEATH_COUNT, ["P", "CNT", "PCNT"])
	_add(out, "events", K_EVENTS, ["P", "CNT", "BUPS_U", "CHILD_U", "SURV", "KID", "EXCS", "EXCK", "EVB", "EVD"])
	_add(out, "ev_count", K_EV_COUNT, ["CNT", "EVN"])
	_add(out, "stats1", K_STATS1, ["CNT", "BUPS", "SPART"], "", 256)
	_add(out, "stats2", K_STATS2, ["CNT", "SPART", "OUT"], "", 256)
	_add(out, "q_clear", K_Q_CLEAR, ["CNT", "PCNT", "OUT"], LAYOUT_GLSL)
	_add(out, "q_pick", K_Q_PICK, ["P", "CNT", "BUPS", "QIN", "QD", "OUT"], LAYOUT_GLSL)
	_add(out, "q_pick2", K_Q_PICK2, ["CNT", "QIN", "QD", "OUT"], LAYOUT_GLSL)
	_add(out, "q_record", K_Q_RECORD, ["BUPS_U", "OUT"], LAYOUT_GLSL)
	_add(out, "q_track", K_Q_TRACK, ["CNT", "BUPS_U", "QIN", "OUT"], LAYOUT_GLSL)
	_add(out, "q_scan", K_Q_SCAN, ["CNT", "BUPS", "QIN", "OUT"], LAYOUT_GLSL, 256)
	_add(out, "erase_cells", K_ERASE_CELLS, ["P", "INSIDE", "CONC", "ERASE"])
	_add(out, "erase_puffs", K_ERASE_PUFFS, ["PCNT", "PUFF", "ERASE"])
	_add(out, "mirror", K_MIRROR, ["PCNT", "PUFF", "MIRROR"])
	_add(out, "out_keep", K_OUT_KEEP, ["OUT", "OUTK"])
	return out


## One kernel: the header with its local size, a declaration for each buffer (binding = position in `buffer_names`; its element type
## from TYPES here, or GpuKernelsDraw.TYPES for the drawing's own buffers), FUNCS, `extra`, then the code. For gpu/kernels_draw.gd too.
static func add(out: Dictionary, kernel_name: String, body: String, buffer_names: Array, extra := "", local := 64) -> void:
	var src := HEAD.replace("local_size_x = 64", "local_size_x = " + str(local))
	for k in buffer_names.size():
		var b: String = buffer_names[k]
		var type: String = TYPES[b] if TYPES.has(b) else GpuKernelsDraw.TYPES[b]
		src += "layout(set = 0, binding = %d, std430) buffer B_%s { %s %s[]; };\n" % [k, b, type, b]
	src += FUNCS + extra + body
	out[kernel_name] = {"source": GENERATED + "#[compute]\n" + src, "buffers": buffer_names, "local_size": local}


static func _add(out: Dictionary, kernel_name: String, body: String, buffer_names: Array, extra := "", local := 64) -> void:
	add(out, kernel_name, body, buffer_names, extra, local)


## The five kernels of an exclusive prefix sum in three levels: `src` to `exc`, with the block sums in s1 / s2 / s3 and their sums scanned.
static func _add_scan_chain(out: Dictionary, prefix: String, src: String, exc: String, s1: String, s1x: String, s2: String, s2x: String, s3: String) -> void:
	_add(out, prefix + "0", K_SCAN.replace("SRC", src).replace("DST", exc).replace("SUMS", s1), [src, exc, s1], "", 256)
	_add(out, prefix + "1", K_SCAN.replace("SRC", s1).replace("DST", s1x).replace("SUMS", s2), [s1, s1x, s2], "", 256)
	_add(out, prefix + "2", K_SCAN.replace("SRC", s2).replace("DST", s2x).replace("SUMS", s3), [s2, s2x, s3], "", 256)
	_add(out, prefix + "a2", K_ADD.replace("DST", s1x).replace("ADDEND", s2x), [s1x, s2x], "", 256)
	_add(out, prefix + "a1", K_ADD.replace("DST", exc).replace("ADDEND", s1x), [exc, s1x], "", 256)
