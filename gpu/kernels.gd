class_name GpuKernels
extends RefCounted
## How the GPU's compute kernels are made: each is GLSL text and the buffers it binds, written by concern in its own file with its
## registration (gpu/kernels_field.gd, kernels_life.gd, kernels_clouds.gd, kernels_game.gd, kernels_draw.gd: each has a `register(out)`
## that calls `add` for its kernels). `all()` gives every kernel's complete file text; tools/gen_gpu_shaders.gd writes those to
## gpu/shaders/<name>.glsl, which the game imports (SPIR-V) and GpuSim loads. After editing a kernel run the generator and then
## `godot --headless --path . --import` (tests/gpu_shaders_test.gd checks both were done). Any change to the model must be made in the
## kernels and in the C++ simulation.

const GENERATED := "// generated by tools/gen_gpu_shaders.gd from gpu/kernels.gd: edit those, not this\n"

const TYPES := {
	"P": "float", "BUPS": "float", "BUPS2": "float", "CHILD": "float", "WANT": "float", "CELLOF": "int", "CONC": "float", "EFF": "float",
	"OWNER": "int", "INSIDE": "int", "DLO": "uint", "DHI": "uint", "RLO": "uint", "RHI": "uint", "ALO": "uint", "AHI": "uint",
	"SCALE": "float", "TABLE": "float", "WGT": "float", "CNT": "uint", "DTAB": "uint", "SURV": "uint", "KID": "uint", "EXCS": "uint", "EXCK": "uint",
	"S1": "uint", "S1X": "uint", "S2": "uint", "S2X": "uint", "S3": "uint",
	"PUFF": "float", "PUFF2": "float", "PUFF_V": "vec4", "PUFF2_V": "vec4", "PCNT": "uint", "PDLO": "uint", "PDHI": "uint", "PSCALE": "float",
	"BINC": "uint", "BINS": "uint", "BCUR": "uint", "ENT": "uint", "ENTD": "vec4", "EVR": "int", "EVP": "float", "EVCC": "int", "EVCA": "float",
	"PQ": "float", "PR": "float", "DPLO": "uint", "DPHI": "uint", "WANTC": "float", "PAL": "uint", "PEXC": "uint", "PS1": "uint", "PS1X": "uint", "PS2": "uint", "PS2X": "uint", "PS3": "uint",
	"BS1": "uint", "BS1X": "uint", "BS2": "uint", "BS2X": "uint", "BS3": "uint",
	# the second food (acetate): its grid (and the copy diffusion needs), the bups' wants and the places they take from, the per-cell sums of what is wanted and let go (2^30 to the unit, two words each) and the share of the want each cell can give
	"CONC2": "float", "CONC2B": "float", "WANT2": "float", "CELL2": "int", "AWLO": "uint", "AWHI": "uint", "ADLO": "uint", "ADHI": "uint", "SCALE2": "float",
	# The bup records read as integers: a record holds its id as two uint words (0 and 21), and an id below 2^23 is a denormal float
	# pattern that a float-typed move may flush, so ids are read through the uint views and records are moved whole through the
	# uvec4 views (16 bytes at a time, so that neighbouring threads touch neighbouring memory). Never copy a record as floats.
	"BUPS_U": "uint", "CHILD_U": "uint", "BUPS_V4U": "uvec4", "BUPS2_V4U": "uvec4", "CHILD_V4U": "uvec4",
	# The game's side (gpu/gpu_world.gd): the family events of a batch (EVB births, EVD deaths, EVN their counts per event set), what
	# the dish asks each frame (QIN) and the answers (OUT: counts, query answers, stats samples, as uint words; floats by their bits),
	# the stats' partial sums (SPART), the eraser's discs (ERASE), the per-bup scratch of a pick (QD) and the field's copy (MIRROR).
	"EVB": "uint", "EVD": "uint", "EVN": "uint", "QIN": "uint", "OUT": "uint", "OUTK": "uint", "SPART": "float", "ERASE": "vec4", "QD": "uint", "MIRROR": "float",
}

# The layouts of P, the bup records (BUPS, BUPS2, CHILD), CNT, PCNT, the family events (EVB, EVD), QIN and OUT are in gpu/gpu_layout.gd
# (GpuLayout): a kernel uses their names (P[P_DELTA], BUPS[b + R_MASS], CNT[CNT_BUPS], ...), which `add` declares at its top. The bup record
# is BupSim.export_state_bytes()' layout, the events BupSim.apply_events'. The entries of P that depend on the step's length or on the
# batch's plan (the "batch" kind there, and the diffusion's k in the push constant) are set for every batch.
# PUFF: 8 floats each: x, y, mass, variance, cut, alive, reach^2, sigma.
# EVB / EVD: EVENT_SETS sets of P_EVENT_CAPACITY events each (a batch writes set `pcs.pb` of `events`). EVN (uint): per set, the births
#       and deaths of its batch (CNT_BIRTHS, CNT_DEATHS at its end; past P_EVENT_CAPACITY they were lost). OUTK (uint): per event set, a copy
#       of OUT as it was at the end of that set's batch (so a stalling read can still find a batch's samples after later frames).

const HEAD := """#version 450
layout(local_size_x = 64) in;
layout(push_constant) uniform PC { float pa; float pb; float pc; float pd; } pcs;
"""

const FUNCS := """
uint hash(uint x) { x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16; return x; }
float u01(inout uint s) { s = hash(s + 0x9e3779b9U); return (float(s >> 8) + 0.5) / 16777216.0; }
float gauss(inout uint s) { float a = u01(s); float b = u01(s); return sqrt(-2.0 * log(a)) * cos(6.2831853 * b); }
"""

## The first lines of a kernel with a thread for each bup (BUP_THREAD: its index `i`, and the threads past the count do nothing;
## BUP_RECORD_THREAD: and `b`, its record's first word) and of a kernel with a thread for each cell of the grid (CELL_THREAD: `i`).
const THREAD_FUNCS := """
#define BUP_THREAD uint i = gl_GlobalInvocationID.x; if (i >= CNT[CNT_BUPS]) return;
#define BUP_RECORD_THREAD BUP_THREAD uint b = i * RECORD_WORDS;
#define CELL_THREAD uint i = gl_GlobalInvocationID.x; if (i >= uint(P[P_CELLS] * P[P_CELLS])) return;
"""

## Sums that many threads add to at once, in fixed point: a 64-bit unsigned number in two words (`LO`, `HI` name the two buffers), so that the
## sum is exact whatever the order the threads run in. ADD_FIXED30 (2^30 to the unit, parts of at most 3.9) and ADD_FIXED20 (2^20 to the
## unit, parts of at most 4000) add an amount; FIX30 and FIX20 read a sum back. Macros, because a function cannot take a buffer.
const FIXED_FUNCS := """
#define ADD64(LO, HI, cell, q_) { uint old_ = atomicAdd(LO[cell], q_); if (old_ + q_ < old_) atomicAdd(HI[cell], 1u); }
#define ADD_FIXED30(LO, HI, cell, amount) { float rest_ = amount; while (rest_ > 0.0) { float part_ = min(rest_, 3.9); rest_ -= part_; uint q_ = uint(part_ * 1073741824.0 + 0.5); ADD64(LO, HI, cell, q_) } }
#define ADD_FIXED20(LO, HI, cell, amount) { float rest_ = amount; while (rest_ > 0.0) { float part_ = min(rest_, 4000.0); rest_ -= part_; uint q_ = uint(part_ * 1048576.0 + 0.5); ADD64(LO, HI, cell, q_) } }
#define FIX30(HI, LO) (float(HI) * 4.0 + float(LO) * 9.313225746154785e-10)
#define FIX20(HI, LO) (float(HI) * 4096.0 + float(LO) * 9.5367431640625e-7)
"""

## An exclusive prefix sum, in three levels of blocks of 256 (so up to 16 million elements): the new place of every bup that is kept
## and of every newborn does not depend on the order the threads run in, so a run is the same every time.
const K_SCAN := """
shared uint tmp[256];
void main() {
	uint gid = gl_GlobalInvocationID.x, lid = gl_LocalInvocationID.x;
	uint n = uint(pcs.pa);
	uint v = gid < n ? SRC[gid] : 0u;
	tmp[lid] = v;
	barrier();
	for (uint off = 1u; off < 256u; off <<= 1u) {
		uint t = lid >= off ? tmp[lid - off] : 0u;
		barrier();
		tmp[lid] += t;
		barrier();
	}
	if (gid < n) DST[gid] = tmp[lid] - v;
	if (lid == 255u) SUMS[gl_WorkGroupID.x] = tmp[255];
}
"""

const K_ADD := """
void main() {
	uint gid = gl_GlobalInvocationID.x;
	if (gid >= uint(pcs.pa)) return;
	DST[gid] += ADDEND[gid / 256u];
}
"""

## The frame's questions (QIN) have room for this many fractions (as scripts/dish.gd reads it: the dish keeps no more fractions asked).
const FRACTIONS := GpuLayout.FRACTIONS


## Every kernel: name -> {"source": the text of its .glsl file (the comment line, `#[compute]`, then the GLSL), "buffers": the names
## bound in order, "local_size": threads per group}.
static func all() -> Dictionary:
	var out := {}
	GpuKernelsField.register(out)
	GpuKernelsLife.register(out)
	GpuKernelsClouds.register(out)
	GpuKernelsGame.register(out)
	GpuKernelsDraw.register(out)
	return out


## One kernel: the header with its local size, a declaration for each buffer (binding = position in `buffer_names`; its element type
## from TYPES here, the simulation's buffers, or from `types` for buffers of the caller's own), the names of gpu/gpu_layout.gd the code
## uses (`layout_names`), FUNCS, `extra`, then the code.
static func add(out: Dictionary, kernel_name: String, body: String, buffer_names: Array, extra := "", local := 64, types := {}) -> void:
	assert(not out.has(kernel_name), "kernel %s is defined twice" % kernel_name)
	var src := HEAD.replace("local_size_x = 64", "local_size_x = " + str(local))
	for k in buffer_names.size():
		var b: String = buffer_names[k]
		var type: String = TYPES[b] if TYPES.has(b) else types[b]
		src += "layout(set = 0, binding = %d, std430) buffer B_%s { %s %s[]; };\n" % [k, b, type, b]
	var code := FUNCS + THREAD_FUNCS + extra + body
	var names := layout_names()
	var used := {}
	for m in _words().search_all(code):
		if names.has(m.get_string()):
			used[m.get_string()] = true
	var declared: Array = used.keys()
	declared.sort()
	for name: String in declared:
		src += names[name] + "\n"
	src += code
	out[kernel_name] = {"source": GENERATED + "#[compute]\n" + src, "buffers": buffer_names, "local_size": local}


static var _layout_names := {}
static var _word_regex: RegEx = null


## Every name gpu/gpu_layout.gd gives the GLSL -> its declaration: each int constant as `const uint NAME = value;`, each slot of P as
## `const int P_<NAME> = slot;`.
static func layout_names() -> Dictionary:
	if _layout_names.is_empty():
		var constants: Dictionary = (load("res://gpu/gpu_layout.gd") as Script).get_script_constant_map()
		for name: String in constants:
			if constants[name] is int:
				_layout_names[name] = "const uint %s = %du;" % [name, constants[name]]
		for slot_name: String in GpuLayout.P_SLOTS:
			var glsl := "P_" + slot_name.to_upper()
			assert(not _layout_names.has(glsl), "GpuLayout: %s is both a constant and a slot of P" % glsl)
			_layout_names[glsl] = "const int %s = %d;" % [glsl, GpuLayout.p_slot(slot_name)]
	return _layout_names


static func _words() -> RegEx:
	if _word_regex == null:
		_word_regex = RegEx.create_from_string("\\b[A-Z][A-Z0-9_]*\\b")
	return _word_regex


## The five kernels of an exclusive prefix sum in three levels: `src` to `exc`, with the block sums in s1 / s2 / s3 and their sums scanned.
static func add_scan_chain(out: Dictionary, prefix: String, src: String, exc: String, s1: String, s1x: String, s2: String, s2x: String, s3: String) -> void:
	add(out, prefix + "0", K_SCAN.replace("SRC", src).replace("DST", exc).replace("SUMS", s1), [src, exc, s1], "", 256)
	add(out, prefix + "1", K_SCAN.replace("SRC", s1).replace("DST", s1x).replace("SUMS", s2), [s1, s1x, s2], "", 256)
	add(out, prefix + "2", K_SCAN.replace("SRC", s2).replace("DST", s2x).replace("SUMS", s3), [s2, s2x, s3], "", 256)
	add(out, prefix + "a2", K_ADD.replace("DST", s1x).replace("ADDEND", s2x), [s1x, s2x], "", 256)
	add(out, prefix + "a1", K_ADD.replace("DST", exc).replace("ADDEND", s1x), [exc, s1x], "", 256)
