[node name="Heading" type="RichTextLabel" parent="Box"]
theme_type_variation = &"StoryHeading"
layout_mode = 2
bbcode_enabled = true
text = "[b]OCTOBER [color=#ffffff]1964[/color].  A STORMY NIGHT.[/b]"
fit_content = true
scroll_active = false

[node name="Body" type="Label" parent="Box"]
theme_type_variation = &"Story"
custom_minimum_size = Vector2(980, 0)
layout_mode = 2
text = "You were in the middle of an experiment (something involving a petri dish, a little nutrient broth, and a great deal of misplaced confidence) when the lightning struck.

It should have shattered the glass. Instead, the dish hummed. And then something in it moved.

Abiogenesis. Real, wriggling, slightly smug life, conjured from nothing in your own laboratory. You have named them Bups.

They are small. They are hungry. They will divide, and mutate, and whichever Bups cope best will inherit the dish. You cannot command them. But the dish is yours: the food, the pressure, the conditions. Manage it carefully, run your experiments, and guide your Bups toward becoming a successful new form of life.

Do try not to let them die. The paperwork is dreadful."
autowrap_mode = 3

[node name="Prompt" type="Label" parent="Box"]
theme_type_variation = &"Hint"
layout_mode = 2
text = "SPACE or click to begin   ·   ESC to skip"
horizontal_alignment = 1

[node name="Flash" type="ColorRect" parent="."]
modulate = Color(1, 1, 1, 0)
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.85, 0.95, 1, 1)
