[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/founders.gd" id="1"]

[node name="Founders" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Title" type="Label" parent="."]
theme_type_variation = &"Title"
layout_mode = 0
offset_left = 48.0
offset_top = 36.0
offset_right = 600.0
offset_bottom = 110.0
text = "@founders.title"

[node name="Subtitle" type="Label" parent="."]
theme_type_variation = &"Accent"
layout_mode = 0
offset_left = 50.0
offset_top = 112.0
offset_right = 900.0
offset_bottom = 140.0
text = "@founders.subtitle"

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 4
anchor_top = 0.5
anchor_bottom = 0.5
offset_left = 48.0
offset_top = 40.0
offset_right = 48.0
offset_bottom = 40.0
grow_horizontal = 1
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Panel"]
theme_type_variation = &"RoomyStack"
layout_mode = 2

[node name="Header" type="HBoxContainer" parent="Panel/Box"]
layout_mode = 2

[node name="Caption" type="Label" parent="Panel/Box/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Bright"
