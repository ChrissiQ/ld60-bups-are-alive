[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/founders.gd" id="1"]
[ext_resource type="Script" path="res://ui/step_indicator.gd" id="steps"]
[ext_resource type="Texture2D" path="res://icons/reset.svg" id="2"]

[node name="Founders" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Heading" type="VBoxContainer" parent="."]
theme_type_variation = &"TightStack"
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 48.0
offset_top = 28.0
offset_right = -48.0
grow_horizontal = 2

[node name="Title" type="Label" parent="Heading"]
layout_mode = 2
theme_type_variation = &"Title"
text = "@founders.title"

[node name="Steps" type="HBoxContainer" parent="Heading"]
layout_mode = 2
script = ExtResource("steps")
step_names = PackedStringArray("@ui.step_setup", "@ui.step_founders")
current = 1

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 0
offset_left = 48.0
offset_top = 130.0
offset_right = 48.0
offset_bottom = 130.0

[node name="Box" type="VBoxContainer" parent="Panel"]
theme_type_variation = &"RoomyStack"
layout_mode = 2

[node name="Tools" type="HFlowContainer" parent="Panel/Box"]
layout_mode = 2
theme_type_variation = &"TightFlow"

[node name="NamesButton" type="Button" parent="Panel/Box/Tools"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "@founders.random_names_tip"
text = "@founders.random_names"

[node name="SpreadButton" type="Button" parent="Panel/Box/Tools"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "@founders.spread_tip"
text = "@founders.spread"

[node name="RandomButton" type="Button" parent="Panel/Box/Tools"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "@founders.random_tip"
text = "@founders.random"

[node name="Scroll" type="ScrollContainer" parent="Panel/Box"]
custom_minimum_size = Vector2(740, 0)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Panel/Box/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Actions" type="HBoxContainer" parent="Panel/Box"]
layout_mode = 2

[node name="ResetButton" type="Button" parent="Panel/Box/Actions"]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "@ui.reset"
icon = ExtResource("2")
tooltip_text = "@founders.reset_tip"

[node name="BackButton" type="Button" parent="Panel/Box/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "@founders.back"

[node name="StartButton" type="Button" parent="Panel/Box/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"PrimaryButton"
text = "@founders.start"
