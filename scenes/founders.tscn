[node name="RandomButton" type="Button" parent="Panel/Box/Header"]
layout_mode = 2
theme_type_variation = &"DialogButton"
tooltip_text = "@founders.random_tip"
text = "@founders.random"

[node name="Scroll" type="ScrollContainer" parent="Panel/Box"]
custom_minimum_size = Vector2(560, 300)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Panel/Box/Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Actions" type="HBoxContainer" parent="Panel/Box"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Panel/Box/Actions"]
