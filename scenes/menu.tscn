[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1"]
[ext_resource type="Script" path="res://scripts/dish.gd" id="2"]
[ext_resource type="PackedScene" path="res://ui/controls_panel.tscn" id="3"]
[ext_resource type="PackedScene" path="res://ui/options_panel.tscn" id="4"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Dish" type="Node2D" parent="."]
modulate = Color(1, 1, 1, 0.45)
script = ExtResource("2")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"RoomyStack"
mouse_filter = 2

[node name="Title" type="Label" parent="Column"]
theme_type_variation = &"Display"
layout_mode = 2
text = "@menu.title"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Tagline" type="Label" parent="Column"]
custom_minimum_size = Vector2(1, 0)
theme_type_variation = &"Tagline"
layout_mode = 2
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Buttons" type="VBoxContainer" parent="Column"]
layout_mode = 2
size_flags_horizontal = 4

[node name="LoadButton" type="Button" parent="Column/Buttons"]
theme_type_variation = &"PrimaryButton"
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "@menu.load_experiment"

[node name="NewButton" type="Button" parent="Column/Buttons"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "@menu.new_experiment"

[node name="FreeButton" type="Button" parent="Column/Buttons"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "@menu.free_mode"

[node name="ControlsButton" type="Button" parent="Column/Buttons"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "@menu.controls"

[node name="OptionsButton" type="Button" parent="Column/Buttons"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "@options.button"

[node name="QuitButton" type="Button" parent="Column/Buttons"]
custom_minimum_size = Vector2(320, 48)
layout_mode = 2
text = "@menu.quit"

[node name="ControlsPanel" parent="." instance=ExtResource("3")]

[node name="OptionsPanel" parent="." instance=ExtResource("4")]

[node name="ConfirmDialog" type="ConfirmationDialog" parent="."]
