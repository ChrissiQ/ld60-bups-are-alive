[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/free_setup.gd" id="1"]
[ext_resource type="Script" path="res://scripts/dish.gd" id="2"]
[ext_resource type="Texture2D" path="res://icons/reset.svg" id="4"]
[ext_resource type="PackedScene" path="res://ui/setting_row.tscn" id="5"]

[node name="FreeSetup" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Dish" type="Node2D" parent="."]
script = ExtResource("2")

[node name="Title" type="Label" parent="."]
theme_type_variation = &"Title"
layout_mode = 0
offset_left = 48.0
offset_top = 36.0
offset_right = 600.0
offset_bottom = 110.0
text = "@free_setup.title"

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 0
offset_left = 48.0
offset_top = 130.0
offset_right = 48.0
offset_bottom = 130.0
grow_horizontal = 1
grow_vertical = 1

[node name="Box" type="VBoxContainer" parent="Panel"]
theme_type_variation = &"RoomyStack"
layout_mode = 2

[node name="Header" type="HBoxContainer" parent="Panel/Box"]
layout_mode = 2

[node name="SectionLabel" type="Label" parent="Panel/Box/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Bright"
text = "@free_setup.header"
vertical_alignment = 1

[node name="ResetButton" type="Button" parent="Panel/Box/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"IconButton"
icon = ExtResource("4")
icon_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="Panel/Box"]
layout_mode = 2
horizontal_scroll_mode = 0
vertical_scroll_mode = 2

[node name="Rows" type="VBoxContainer" parent="Panel/Box/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"RoomyStack"

[node name="BupsRow" parent="Panel/Box/Scroll/Rows" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.bups"

[node name="NutrientsRow" parent="Panel/Box/Scroll/Rows" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.start_nutrient"
label_tip = "@free_setup.start_density_tip"

[node name="RateRow" parent="Panel/Box/Scroll/Rows" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.nutrient_feed"
label_tip = "@free_setup.feed_tip"

[node name="BloomRow" parent="Panel/Box/Scroll/Rows" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.plankton_bloom"

[node name="DishRow" parent="Panel/Box/Scroll/Rows" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.dish_radius"

[node name="LimitRow" parent="Panel/Box/Scroll/Rows" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.bup_limit"

[node name="TutorialToggle" type="Button" parent="Panel/Box/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"ListButton"
toggle_mode = true
alignment = 0
text = "@free_setup.tutorial_off"

[node name="AdvancedToggle" type="Button" parent="Panel/Box/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"ListButton"
alignment = 0
text = "@free_setup.advanced_closed"

[node name="Advanced" type="VBoxContainer" parent="Panel/Box/Scroll/Rows"]
visible = false
layout_mode = 2
theme_type_variation = &"RoomyStack"

[node name="NoteRow" type="HBoxContainer" parent="Panel/Box/Scroll/Rows/Advanced"]
layout_mode = 2

[node name="Note" type="Label" parent="Panel/Box/Scroll/Rows/Advanced/NoteRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Hint"
text = "@free_setup.advanced_note"
autowrap_mode = 3

[node name="AdvancedReset" type="Button" parent="Panel/Box/Scroll/Rows/Advanced/NoteRow"]
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"IconButton"
icon = ExtResource("4")
icon_alignment = 1

[node name="DetailRow" parent="Panel/Box/Scroll/Rows/Advanced" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.nutrient_detail"
label_tip = "@free_setup.detail_tip"

[node name="ThicknessRow" parent="Panel/Box/Scroll/Rows/Advanced" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.medium_thickness"
label_tip = "@free_setup.thickness_tip"

[node name="BackendBox" type="VBoxContainer" parent="Panel/Box/Scroll/Rows/Advanced"]
layout_mode = 2
theme_type_variation = &"TightStack"

[node name="BackendRow" type="HBoxContainer" parent="Panel/Box/Scroll/Rows/Advanced/BackendBox"]
layout_mode = 2

[node name="BackendLabel" type="Label" parent="Panel/Box/Scroll/Rows/Advanced/BackendBox/BackendRow"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "@free_setup.backend_tip"
mouse_filter = 0
text = "@free_setup.backend"

[node name="AutoButton" type="Button" parent="Panel/Box/Scroll/Rows/Advanced/BackendBox/BackendRow"]
layout_mode = 2
theme_type_variation = &"ToolButton"
toggle_mode = true
text = "@free_setup.backend_auto"

[node name="OnButton" type="Button" parent="Panel/Box/Scroll/Rows/Advanced/BackendBox/BackendRow"]
layout_mode = 2
theme_type_variation = &"ToolButton"
toggle_mode = true
text = "@free_setup.backend_on"

[node name="OffButton" type="Button" parent="Panel/Box/Scroll/Rows/Advanced/BackendBox/BackendRow"]
layout_mode = 2
theme_type_variation = &"ToolButton"
toggle_mode = true
text = "@free_setup.backend_off"

[node name="BackendHint" type="Label" parent="Panel/Box/Scroll/Rows/Advanced/BackendBox"]
layout_mode = 2
theme_type_variation = &"Hint"
text = "@free_setup.backend_hint"
autowrap_mode = 3

[node name="BackendNotice" type="Label" parent="Panel/Box/Scroll/Rows/Advanced/BackendBox"]
visible = false
layout_mode = 2
theme_type_variation = &"Notice"
text = "@free_setup.backend_unavailable"
autowrap_mode = 3

[node name="StationaryToggle" type="Button" parent="Panel/Box/Scroll/Rows/Advanced"]
layout_mode = 2
theme_type_variation = &"ListButton"
toggle_mode = true
button_pressed = true
alignment = 0
text = "@free_setup.stationary_on"

[node name="HusksToggle" type="Button" parent="Panel/Box/Scroll/Rows/Advanced"]
layout_mode = 2
theme_type_variation = &"ListButton"
toggle_mode = true
alignment = 0
text = "@free_setup.husks_off"

[node name="Actions" type="HBoxContainer" parent="Panel/Box"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Panel/Box/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "@free_setup.back"

[node name="GoButton" type="Button" parent="Panel/Box/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"PrimaryButton"
text = "@free_setup.next"
