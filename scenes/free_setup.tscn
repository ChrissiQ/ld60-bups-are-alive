[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/free_setup.gd" id="1"]
[ext_resource type="Script" path="res://ui/step_indicator.gd" id="steps"]
[ext_resource type="Texture2D" path="res://icons/warning.svg" id="warning_icon"]
[ext_resource type="Script" path="res://scripts/dish.gd" id="2"]
[ext_resource type="Texture2D" path="res://icons/reset.svg" id="4"]
[ext_resource type="PackedScene" path="res://ui/toggle_row.tscn" id="toggle_row"]
[ext_resource type="PackedScene" path="res://ui/setting_row.tscn" id="5"]

[node name="FreeSetup" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Dish" type="Node2D" parent="."]
script = ExtResource("2")

[node name="Heading" type="VBoxContainer" parent="."]
theme_type_variation = &"TightStack"
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 48.0
offset_top = 28.0
offset_right = -48.0
grow_horizontal = 2

[node name="Title" type="Label" parent="Heading"]
layout_mode = 2
theme_type_variation = &"Title"
text = "@free_setup.title"

[node name="Steps" type="HBoxContainer" parent="Heading"]
layout_mode = 2
script = ExtResource("steps")
step_names = PackedStringArray("@ui.step_setup", "@ui.step_founders")
current = 0

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 0
offset_left = 48.0
offset_top = 130.0
offset_right = 48.0
offset_bottom = 130.0
grow_horizontal = 1
grow_vertical = 1

[node name="Box" type="VBoxContainer" parent="Panel"]
theme_type_variation = &"RoomyStack"
layout_mode = 2

[node name="Tabs" type="PanelContainer" parent="Panel/Box"]
layout_mode = 2
theme_type_variation = &"Segments"

[node name="Choices" type="HBoxContainer" parent="Panel/Box/Tabs"]
layout_mode = 2
theme_type_variation = &"SegmentRow"

[node name="BasicTab" type="Button" parent="Panel/Box/Tabs/Choices"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TabButton"
toggle_mode = true
button_pressed = true
text = "@free_setup.tab_basic"

[node name="AdvancedTab" type="Button" parent="Panel/Box/Tabs/Choices"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"TabButton"
toggle_mode = true
text = "@free_setup.advanced"

[node name="Scroll" type="ScrollContainer" parent="Panel/Box"]
layout_mode = 2
horizontal_scroll_mode = 0
vertical_scroll_mode = 2

[node name="Rows" type="VBoxContainer" parent="Panel/Box/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"RoomyStack"

[node name="PageLead" type="Control" parent="Panel/Box/Scroll/Rows"]
layout_mode = 2
mouse_filter = 2

[node name="BupsRow" parent="Panel/Box/Scroll/Rows" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.bups"


[node name="NutrientsGroup" type="VBoxContainer" parent="Panel/Box/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"TightStack"

[node name="NutrientsRow" parent="Panel/Box/Scroll/Rows/NutrientsGroup" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.start_nutrient"


[node name="RateGroup" type="VBoxContainer" parent="Panel/Box/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"TightStack"

[node name="RateRow" parent="Panel/Box/Scroll/Rows/RateGroup" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.nutrient_feed"


[node name="BloomGroup" type="VBoxContainer" parent="Panel/Box/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"TightStack"

[node name="BloomRow" parent="Panel/Box/Scroll/Rows/BloomGroup" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.plankton_bloom"

[node name="BloomHint" type="Label" parent="Panel/Box/Scroll/Rows/BloomGroup"]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"Note"
text = "@free_setup.bloom_hint"
autowrap_mode = 3

[node name="DishRow" parent="Panel/Box/Scroll/Rows" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.dish_radius"


[node name="LimitGroup" type="VBoxContainer" parent="Panel/Box/Scroll/Rows"]
layout_mode = 2
theme_type_variation = &"TightStack"

[node name="LimitRow" parent="Panel/Box/Scroll/Rows/LimitGroup" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.bup_limit"

[node name="LimitHint" type="Label" parent="Panel/Box/Scroll/Rows/LimitGroup"]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"Note"
text = "@free_setup.limit_hint"
autowrap_mode = 3

[node name="TutorialToggle" parent="Panel/Box/Scroll/Rows" instance=ExtResource("toggle_row")]
layout_mode = 2
label_text = "@free_setup.tutorial_name"

[node name="Advanced" type="VBoxContainer" parent="Panel/Box/Scroll/Rows"]
visible = false
layout_mode = 2
theme_type_variation = &"SectionStack"

[node name="NoteRow" type="HBoxContainer" parent="Panel/Box/Scroll/Rows/Advanced"]
layout_mode = 2

[node name="WarningIcon" type="Button" parent="Panel/Box/Scroll/Rows/Advanced/NoteRow"]
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"WarningIcon"
disabled = true
focus_mode = 0
mouse_filter = 2
icon = ExtResource("warning_icon")
icon_alignment = 1
expand_icon = true

[node name="Note" type="Label" parent="Panel/Box/Scroll/Rows/Advanced/NoteRow"]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"Warning"
text = "@free_setup.advanced_note"
vertical_alignment = 1
autowrap_mode = 3


[node name="Options" type="VBoxContainer" parent="Panel/Box/Scroll/Rows/Advanced"]
layout_mode = 2
theme_type_variation = &"RoomyStack"

[node name="DetailGroup" type="VBoxContainer" parent="Panel/Box/Scroll/Rows/Advanced/Options"]
layout_mode = 2
theme_type_variation = &"TightStack"

[node name="DetailRow" parent="Panel/Box/Scroll/Rows/Advanced/Options/DetailGroup" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.nutrient_detail"

[node name="DetailHint" type="Label" parent="Panel/Box/Scroll/Rows/Advanced/Options/DetailGroup"]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"Note"
text = "@free_setup.detail_tip"
autowrap_mode = 3

[node name="ThicknessGroup" type="VBoxContainer" parent="Panel/Box/Scroll/Rows/Advanced/Options"]
layout_mode = 2
theme_type_variation = &"TightStack"

[node name="ThicknessRow" parent="Panel/Box/Scroll/Rows/Advanced/Options/ThicknessGroup" instance=ExtResource("5")]
layout_mode = 2
label_text = "@free_setup.medium_thickness"

[node name="ThicknessHint" type="Label" parent="Panel/Box/Scroll/Rows/Advanced/Options/ThicknessGroup"]
custom_minimum_size = Vector2(1, 0)
layout_mode = 2
theme_type_variation = &"Note"
text = "@free_setup.thickness_tip"
autowrap_mode = 3

[node name="BackendToggle" parent="Panel/Box/Scroll/Rows/Advanced/Options" instance=ExtResource("toggle_row")]
layout_mode = 2
label_text = "@free_setup.backend"
auto_text = "@free_setup.backend_auto"
hint_text = "@free_setup.backend_hint"

[node name="BackendNotice" type="Label" parent="Panel/Box/Scroll/Rows/Advanced/Options"]
custom_minimum_size = Vector2(1, 0)
visible = false
layout_mode = 2
theme_type_variation = &"Notice"
text = "@free_setup.backend_unavailable"
autowrap_mode = 3

[node name="StationaryToggle" parent="Panel/Box/Scroll/Rows/Advanced/Options" instance=ExtResource("toggle_row")]
layout_mode = 2
label_text = "@free_setup.stationary_name"
hint_text = "@free_setup.stationary_hint"

[node name="HusksToggle" parent="Panel/Box/Scroll/Rows/Advanced/Options" instance=ExtResource("toggle_row")]
layout_mode = 2
label_text = "@free_setup.husks_name"
hint_text = "@free_setup.husks_hint"

[node name="PlanktonHusksToggle" parent="Panel/Box/Scroll/Rows/Advanced/Options" instance=ExtResource("toggle_row")]
layout_mode = 2
label_text = "@free_setup.plankton_husks_name"
hint_text = "@free_setup.plankton_husks_hint"

[node name="Actions" type="HBoxContainer" parent="Panel/Box"]
layout_mode = 2

[node name="ResetButton" type="Button" parent="Panel/Box/Actions"]
layout_mode = 2
theme_type_variation = &"SmallButton"
text = "@ui.reset"
icon = ExtResource("4")

[node name="BackButton" type="Button" parent="Panel/Box/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "@free_setup.back"

[node name="GoButton" type="Button" parent="Panel/Box/Actions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"PrimaryButton"
text = "@free_setup.next"
